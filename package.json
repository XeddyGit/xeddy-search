    "@prisma/client": "^5.22.0",
    "@radix-ui/react-icons": "^1.3.2",
    "@react-google-maps/api": "^2.20.3",
    "@sendgrid/mail": "^8.1.4",
    "@supabase/supabase-js": "^2.46.2",
    "@testing-library/jest-dom": "^5.17.0",
    "@testing-library/react": "^13.4.0",
    "@testing-library/user-event": "^13.5.0",
    "@types/react": "^18.3.12",
    "@types/react-router-dom": "^5.3.3",
    "axios": "^1.7.9",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^7.4.1",
    "helmet": "^8.0.0",
    "libphonenumber-js": "^1.11.15",
    "lucide-react": "^0.460.0",
    "nodemailer": "^6.9.16",
    "path-browserify": "^1.0.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-ga4": "^2.1.0",
    "react-hook-form": "^7.53.2",
    "react-icons": "^5.3.0",
    "react-router-dom": "^6.28.0",
    "react-scripts": "5.0.1",
    "sendgrid": "^1.9.2",
    "tabler-icons-react": "^1.56.0",
    "tailwind-merge": "^2.5.4",
    "twilio": "^5.3.6",
    "typescript": "^4.9.5",
    "web-vitals": "^2.1.4",
    "zod": "^3.23.8"
  },
  "scripts": {
    "start": "react-scripts start",
    "server": "node server/server.js",
    "dev": "concurrently \"npm start\" \"npm run server\"",
    "build": "react-scripts build",
    "test": "react-scripts test",
    "eject": "react-scripts eject",
    "predeploy": "react-scripts build",
    "deploy": "npm run build && gcloud builds submit --tag gcr.io/xeddy-search/react && gcloud run deploy search-service --image gcr.io/xeddy-search/react --platform managed",
    "deploy:backend": "cd server && gcloud builds submit --tag gcr.io/xeddy-search/backend . && gcloud run deploy email-service --image gcr.io/xeddy-search/backend --platform managed --set-env-vars REACT_APP_SENDGRID_API_KEY=${REACT_APP_SENDGRID_API_KEY},REACT_APP_SENDGRID_VERIFIED_SENDER=${REACT_APP_SENDGRID_VERIFIED_SENDER}"
  },
  "eslintConfig": {
    "extends": [
      "react-app",
      "react-app/jest"
    ]
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "devDependencies": {
    "@shadcn/ui": "^0.0.4",
    "@types/cors": "^2.8.17",
    "@types/nodemailer": "^6.4.17",
    "@types/twilio": "^3.19.3",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.1.0",
    "gh-pages": "^6.2.0",
    "postcss": "^8.4.49",
    "prisma": "^5.22.0",
    "react-app-rewired": "^2.2.1",
    "tailwindcss": "^3.4.15",
    "ts-node": "^10.9.2"
  },
  "resolutions": {
    "@babel/traverse": "^7.23.2"
  }
}
